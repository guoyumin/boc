# 复制成 deploy/.env 再改。这个文件里的值会进容器。
DATABASE_PATH=/data/boc.db
UPLOAD_DIR=/data/uploads

# 首次启动（admins 表为空）时创建初始管理员，之后改这里没用
OWNER_USERNAME=owner
OWNER_PASSWORD=换成一个长密码

APP_URL=https://play.zurich-boca.party

# 两个站的域名。同一个容器按 Host 分流：www 是社团主页，play 是报名/投票/个人中心。
# 不填就是下面这两个默认值，本地开发默认 www.localhost:3000 / play.localhost:3000。
WWW_HOST=www.zurich-boca.party
PLAY_HOST=play.zurich-boca.party
TZ=Europe/Zurich

# 1 = 空库启动时写入演示数据（正式部署请保持 0）
SEED_DEMO=0
